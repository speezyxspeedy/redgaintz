# TERRASCAN configuration. Copy to .env (git-ignored). Never put secrets in VITE_* variables:
# everything prefixed VITE_ is copied into the public JavaScript bundle.

# Public base path for static hosting (GitHub Pages: /<repository>/)
VITE_BASE_PATH=/

# Optional Cesium ion token. It is public by design: restrict it to your domain in the Cesium ion dashboard.
VITE_CESIUM_ION_ACCESS_TOKEN=

# Optional backend for live runs (pipeline/api.py)
VITE_API_BASE_URL=http://127.0.0.1:8000

# Server-side only (pipeline/, never the browser):
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
