{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://terrascan.example/schemas/dataset.schema.json",
  "title": "Dataset registry entry",
  "type": "object",
  "required": ["dataset_id", "name", "provider", "version", "variable", "units", "temporal_resolution", "spatial_resolution", "verified"],
  "properties": {
    "dataset_id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "provider": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "variable": { "type": "string", "minLength": 1 },
    "units": { "type": "string", "minLength": 1 },
    "temporal_resolution": { "type": "string", "minLength": 1 },
    "spatial_resolution": { "type": "string", "minLength": 1 },
    "verified": { "type": "boolean" },
    "disabled_reason": { "type": "string" },
    "supports": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
