-module__jG9c2G__link menu-item-module-scss-module__jG9c2G__link--btn" aria-hidden="false">Sign Out</button></li></ul></div></li></ul><button class="site-nav-module-scss-module__oJCOAa__btn" type="button" aria-haspopup="menu" aria-expanded="false"><span class="site-nav-module-scss-module__oJCOAa__hamburger"></span><span class="site-nav-module-scss-module__oJCOAa__hidden">Menu</span></button></nav></div></div></div></div></header><div id="earth-system-trend-detective" class="index-module-scss-module__LrtIIa__content-container"><div class="page-meta-module-scss-module__jpMY-a__container undefined"><div class="container-module-scss-module__GNU7ba__row "><ul class="breadcrumbs-module-scss-module__r1foPa__crumbs undefined"><li class="breadcrumbs-module-scss-module__r1foPa__icon breadcrumbs-module-scss-module__r1foPa__crumb-icon"><a class="breadcrumbs-module-scss-module__r1foPa__crumb__link" href="https://www.spaceappschallenge.org/"><svg class="icon icon-module-scss-module__Ik2gAa__icon icon-module-scss-module__Ik2gAa__stroke undefined "><use href="/assets/sprite.svg#spaceapps/meteor"></use></svg></a></li><li class="breadcrumbs-module-scss-module__r1foPa__mobile-crumbs "><button class="breadcrumbs-module-scss-module__r1foPa__ellipse-btn"><span class="breadcrumbs-module-scss-module__r1foPa__ellipse"></span></button><ul class="breadcrumbs-module-scss-module__r1foPa__dropdown"><li class="breadcrumbs-module-scss-module__r1foPa__crumb"><a class="breadcrumbs-module-scss-module__r1foPa__crumb__link" href="https://www.spaceappschallenge.org/2026/">2026 NASA Space Apps Challenge</a></li><li class="breadcrumbs-module-scss-module__r1foPa__crumb"><a class="breadcrumbs-module-scss-module__r1foPa__crumb__link" href="https://www.spaceappschallenge.org/2026/challenges/">2026 Challenges</a></li></ul></li></ul></div></div><div class="page-hero-module-scss-module__gOzt4a__container page-hero-module-scss-module__gOzt4a__event page-hero-module-scss-module__gOzt4a__lg page-hero-module-scss-module__gOzt4a__tabbed"><div class="page-hero-module-scss-module__gOzt4a__background"><div class="page-hero-module-scss-module__gOzt4a__wrapper"><img alt="Illustration of Earth with four quadrants showing different global data layers, including weather, precipitation, land surface, and atmospheric patterns." loading="lazy" width="514" height="432" decoding="async" data-nimg="1" class="page-hero-module-scss-module__gOzt4a__img" style="color:transparent" src="https://assets.spaceappschallenge.org/media/images/earth_systems_JRUXY8b.2e16d0ba.fill-785x660.jpg"></div></div><div class="page-hero-module-scss-module__gOzt4a__content"><div class="container-module-scss-module__GNU7ba__row "><div class="page-header-module-scss-module__DrzMzq__container page-header-module-scss-module__DrzMzq__lg page-header-module-scss-module__DrzMzq__dark"><div class="page-header-module-scss-module__DrzMzq__content"><h1 class="page-header-module-scss-module__DrzMzq__title">Be An Earth System Trend Detective!</h1><div><a class="link-module-scss-module__kwxgZq__link link-module-scss-module__kwxgZq__primary link-module-scss-module__kwxgZq__button link-module-scss-module__kwxgZq__sm link-module-scss-module__kwxgZq__before" href="https://www.spaceappschallenge.org/2026/challenges/earth-system-trend-detective//?tab=teams"><svg class="icon icon-module-scss-module__Ik2gAa__icon icon-module-scss-module__Ik2gAa__stroke undefined "><use href="/assets/sprite.svg#spaceapps/plus"></use></svg>Join the Challenge</a></div></div></div></div></div></div><div class="container-module-scss-module__GNU7ba__row "><div class="challenge-module-scss-module__JSY-YW__container"><div class="tabbed-content-module-scss-module__j-NupW__container"><div class="react-tabs" data-rttabs="true"><ul class="react-tabs__tab-list" role="tablist"><li class="react-tabs__tab" role="tab" id="tab_r_0_0" aria-selected="false" aria-disabled="false" aria-controls="panel_r_0_0" data-rttab="true">Details</li><li class="react-tabs__tab react-tabs__tab--selected" role="tab" id="tab_r_0_1" aria-selected="true" aria-disabled="false" aria-controls="panel_r_0_1" data-rttab="true" tabindex="0">Resources</li><li class="react-tabs__tab" role="tab" id="tab_r_0_2" aria-selected="false" aria-disabled="false" aria-controls="panel_r_0_2" data-rttab="true">Teams</li></ul><div class="react-tabs__tab-panel" role="tabpanel" id="panel_r_0_0" aria-labelledby="tab_r_0_0"></div><div class="react-tabs__tab-panel react-tabs__tab-panel--selected" role="tabpanel" id="panel_r_0_1" aria-labelledby="tab_r_0_1"><div class="challenge-resources-module-scss-module__X6FS6a__container"><div class="container-module-scss-module__GNU7ba__row "><div class="container-module-scss-module__GNU7ba__col container-module-scss-module__GNU7ba__md"><div class="html-container-module-scss-module__MAMAVW__html-container challenge-resources-module-scss-module__X6FS6a__content"><p data-block-key="10lsb"><i>NASA does not endorse any non-U.S. Government entity and is not responsible for information contained on non-U.S. Government websites. For non-U.S. Government websites, participants must comply with any data use parameters of that specific website.</i></p><h2 data-block-key="brah7"><b>NASA Data &amp; Resources</b></h2><p data-block-key="8nvo6"><a href="https://giovanni.gsfc.nasa.gov/"><b>Giovanni</b></a><b>:</b> Versatile tool that provides menus of numerous data variables, and allows generation of time series and download of the time series data.</p><p data-block-key="9s63l"><a href="https://disc.gsfc.nasa.gov/information/tools?title=Hydrology%20Time%20Series"><b>Hydrology Time Series</b></a><b>:</b> Allows generation of time-series with hydrological data.</p><p data-block-key="5irg2"><a href="https://appeears.earthdatacloud.nasa.gov/"><b>AppEEARS</b></a><b>:</b> Offers a simple and efficient way to access and transform geospatial data from a variety of federal data archives. Includes time-series generation.</p><p data-block-key="24n9"><a href="https://www.ncei.noaa.gov/cdo-web/" data-external="" data-processed="true"><b>Climate Data Online (CDO)</b><span class="icon-container"><svg class="icon icon-module-scss-module__Ik2gAa__icon icon-module-scss-module__Ik2gAa__stroke undefined "><use href="/assets/sprite.svg#spaceapps/external"></use></svg></span></a><b>:</b> CDO provides free access to NCDC's archive of global historical weather and climate data in addition to station history information. This site includes a mapping tool.</p><p data-block-key="9ak92"><a href="https://ntrs.nasa.gov/api/citations/20090042747/downloads/20090042747.pdf"><b>Time-Series Analysis of Remotely-Sensed SeaWiFS Chlorophyll in River-Influenced Coastal Regions</b></a><b>:</b> Research article demonstrating time-series creation and significance testing.</p><h2 data-block-key="faggf"><b>Space Agency Partner Resources</b></h2><p data-block-key="8v2ne"><a href="https://climexp.knmi.nl/" data-external="" data-processed="true"><b>Royal Netherlands Meteorological Institute (KNMI)</b> <b>Climate Explorer</b><span class="icon-container"><svg class="icon icon-module-scss-module__Ik2gAa__icon icon-module-scss-module__Ik2gAa__stroke undefined "><use href="/assets/sprite.svg#spaceapps/external"></use></svg></span></a><b>:</b> The KNMI Climate Explorer is a web-based scientific analysis tool developed and maintained by the KNMI. It is designed to help researchers, students, and climate analysts explore, analyze, and visualize climate data from a wide range of sources.</p><p data-block-key="dsfnt"><a href="https://medium.com/@snp.kriss/statistical-test-methods-to-detect-trends-in-time-series-data-b361a0ec530b" data-external="" data-processed="true"><b>Statistical test methods to detect trends in time series data</b><span class="icon-container"><svg class="icon icon-module-scss-module__Ik2gAa__icon icon-module-scss-module__Ik2gAa__stroke undefined "><use href="/assets/sprite.svg#spaceapps/external"></use></svg></span></a><b>:</b> Article about testing trends in data.</p><p data-block-key="8eani"><a href="https://www.statsig.com/perspectives/a-comprehensive-guide-to-statistical-significance" data-external="" data-processed="true"><b>A Comprehensive Guide to Statistical Significance</b><span class="icon-container"><svg class="icon icon-module-scss-module__Ik2gAa__icon icon-module-scss-module__Ik2gAa__stroke undefined "><use href="/assets/sprite.svg#spaceapps/external"></use></svg></span></a><b>:</b> A guide to significance testing.</p><p data-block-key="a931r"><b>CSA (Canadian Space Agency)</b></p><p data-block-key="58d9o"><a href="https://donnees-data.asc-csa.gc.ca/en/dataset/rcm" data-external="" data-processed="true"><b>Radarsat Constellation Mission (RCM) - Data</b><span class="icon-container"><svg class="icon icon-module-scss-module__Ik2gAa__icon icon-module-scss-module__Ik2gAa__stroke undefined "><use href="/assets/sprite.svg#spaceapps/external"></use></svg></span></a>: The RADARSAT Constellation Mission (RCM) is Canada's new generation of Earth observation satellites. The RCM includes a trio of Earth observation satellites, capable of scanning Earth day or night and in any weather conditions. The RCM is designed to provide effective solutions in three main areas: Maritime surveillance (ice, surface wind, oil pollution and ship monitoring); Disaster management (mitigation, warning, response and recovery); and Ecosystem monitoring (agriculture, wetlands, forestry and coastal change monitoring).</p><p data-block-key="erhe9"><a href="http://geo.ca/" data-external="" data-processed="true"><b>Geo.ca</b><span class="icon-container"><svg class="icon icon-module-scss-module__Ik2gAa__icon icon-module-scss-module__Ik2gAa__stroke undefined "><use href="/assets/sprite.svg#spaceapps/external"></use></svg></span></a><b>:</b> GEO.ca is the definitive source for Canadaâ€™s open geospatial information. Some of this data might be helpful for monitoring environmental issues in Canada.</p><p data-block-key="4g1mi"><a href="https://www.asc-csa.gc.ca/eng/satellites/swot/" data-external="" data-processed="true"><b>SWOT Mission - Information</b><span class="icon-container"><svg class="icon icon-module-scss-module__Ik2gAa__icon icon-module-scss-module__Ik2gAa__stroke undefined "><use href="/assets/sprite.svg#spaceapps/external"></use></svg></span></a><b>:</b> The SWOT mission is providing us with new and detailed information on one of the most important resources we share â€“ water. Led by NASA and France's space agency (CNES), in collaboration with the CSA and the UK Space Agency, SWOT surveys 90% of Earth's surface water, measuring changes in water surface elevation for lakes, rivers, reservoirs, and oceans over time.</p><p data-block-key="f5c1f"><a href="https://www.asc-csa.gc.ca/eng/satellites/everyday-lives/monitoring-and-protecting-our-ecosystems-from-space.asp" data-external="" data-processed="true"><b>Monitoring and protecting our ecosystem from space</b><span class="icon-container"><svg class="icon icon-module-scss-module__Ik2gAa__icon icon-module-scss-module__Ik2gAa__stroke undefined "><use href="/assets/sprite.svg#spaceapps/external"></use></svg></span></a><b>:</b> This website provides more information on ways satellite data can help monitor changes and promote the responsible use of land and natural resources to protect the ecosystem.</p><p data-block-key="ao927"><a href="https://github.com/asc-csa/Synthetic_Aperture_Radar_Tutorial" data-external="" data-processed="true"><b>Synthetic Aperture Radar python Tutorial</b><span class="icon-container"><svg class="icon icon-module-scss-module__Ik2gAa__icon icon-module-scss-module__Ik2gAa__stroke undefined "><use href="/assets/sprite.svg#spaceapps/external"></use></svg></span></a><b>:</b> This tutorial demonstrates how to work with SAR imagery using Python and QGIS. It includes easy and practical steps for accessing and visualizing data.</p></div></div></div></div></div><div class="react-tabs__tab-panel" role="tabpanel" id="panel_r_0_2" aria-label