.shadow { box-shadow: rgba(0, 0, 0, 0) 0px 0px, rgba(0, 0, 0, 0) 0px 0px, rgba(0, 0, 0, 0.1) 0px 10px 15px -3px, rgba(0, 0, 0, 0.05) 0px 4px 6px -2px; }

.rounded { border-radius: 1.5rem; }

.btn { text-align: center; white-space: nowrap; vertical-align: middle; user-select: none; transition: color var(--transition),background-color var(--transition),border-color var(--transition),box-shadow var(--transition); border: 1px solid rgba(0, 0, 0, 0); border-radius: 0.25rem; padding: 0.75rem 1.25rem; font-size: 1.5rem; font-weight: 500; line-height: 1.5; display: inline-block; }

.btn:hover, .btn:focus { text-decoration: none; }

.btn:focus, .btn.focus { box-shadow: var(--boxshadow); outline: 0px; }

.btn.disabled, .btn:disabled { opacity: 0.65; }

.btn:not(:disabled):not(.disabled) { cursor: pointer; }

.btn:not(:disabled):not(.disabled):active, .btn:not(:disabled):not(.disabled).active { background-image: none; }

hr { clear: both; width: 100%; overflow: unset; background: linear-gradient(90deg,var(--brand-claygray,#ccc)46%,transparent 46%); border-width: medium; border-style: none; border-color: currentcolor; border-image: none; margin: 1em 0px; padding: 1px 2px; display: block; position: relative; }

hr::before { background: linear-gradient(90deg,transparent 54%,var(--brand-claygray,#ccc)46%); content: ""; width: 100%; height: 100%; display: block; position: absolute; top: 0%; right: 0%; }

hr::after { content: ""; background-image: url("../media/meteor.svg.63b12d89.js"); background-position: 50% center; background-repeat: no-repeat; width: 24px; height: 24px; padding: 2px 16px; display: block; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); }

.scale-on-hover { transition: transform var(--transition); }

.scale-on-hover:hover, .scale-on-hover:focus, .scale-on-hover:active { transform: scale(1.05); }

.uppercase { text-transform: uppercase; }

.form { width: 100%; }

.form__field-group { border-left: .25rem solid var(--brand-cloudgray); flex-flow: column wrap; justify-content: space-between; align-items: flex-end; margin-bottom: 2rem; padding: 0.25rem 0px 0.25rem 1rem; display: flex; }

@media screen and (min-width: 768px) {
  .form__field-group { flex-direction: row; gap: 10px; }
}

.form__field { flex: 1 1 0%; width: 100%; }

.form__label { color: var(--brand-slategray); margin-bottom: 1rem; font-size: 1.25rem; font-weight: 700; }

.form__error { background-color: var(--brand-nasared); width: auto; color: var(--brand-white); border-radius: 2px; gap: 0.5rem; margin: -1rem 0px 1rem; padding: 2px 8px 0px 5px; font-size: 0.825rem; display: inline-flex; }

